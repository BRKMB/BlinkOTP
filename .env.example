# Chrome extension OAuth (manifest + Chrome browser)
VITE_GOOGLE_CLIENT_ID=your-chrome-extension-client-id.apps.googleusercontent.com

# Web OAuth (Brave) — same project, Web application client
VITE_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# OPTIONAL — local dev only. Do NOT set for npm run build:store / pack:store.
VITE_GOOGLE_WEB_CLIENT_SECRET=
